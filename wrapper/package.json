{
  "name": "helios",
  "productName": "H.E.L.I.O.S.",
  "version": "1.5.2",
  "description": "Heuristic Engine for Logic, Input and Output Synthesis",
  "main": "src/main.js",
  "build": {
    "appId": "com.darklorddad.helios",
    "productName": "H.E.L.I.O.S.",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [],
  "author": "darklorddad",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^39.2.2",
    "electron-builder": "^26.0.12",
    "env-cmd": "^11.0.0"
  },
  "dependencies": {
    "electron-log": "^5.4.3"
  }
}
